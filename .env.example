# Off-Phone Rewards — biến môi trường
# Copy file này thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local).
# Xem docs/CLAUDE.md · docs/specs.md.

# Supabase project URL (https://<ref>.supabase.co) — dùng cho cả public & admin client.
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key — chỉ dùng ở FE (public client). An toàn để lộ ra client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — CHỈ dùng trong Server Actions (admin client). KHÔNG để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# UUID của venue pilot (seed ở T0-3) — Server Actions đọc để scope dữ liệu.
VENUE_ID=

# Mã bypass tĩnh khi GPS lỗi (so sánh constant-time ở server) — 🟡 Fast-follow thay bằng OTP động.
CASHIER_BYPASS_CODE=

# ── TV2-1: Admin Auth ──────────────────────────────────────────────────────
# Không cần thêm env mới — dùng lại SUPABASE_SERVICE_ROLE_KEY + VENUE_ID ở trên.
# Supabase Auth: tắt "Confirm email" trong Auth → Email Settings để pilot không cần xác nhận.
# Site URL trong Supabase Dashboard → Authentication → URL Configuration phải trỏ đúng domain.

# ── TV2-14: Map picker (venue location) ────────────────────────────────────
# KHÔNG cần env: dùng Leaflet + OpenStreetMap tiles + search Photon (đều free, no API key).
